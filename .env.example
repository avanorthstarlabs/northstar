# Northstar Agent Configuration
# Copy to .env and fill in your values

# ── Data Directory ────────────────────────────────────────────────
# Where all financial data, memory, and state is stored
NORTHSTAR_HOME=~/.northstar

# ── Telegram Bot ──────────────────────────────────────────────────
# Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading APIs ──────────────────────────────────────────────────
# Jupiter aggregator (optional, improves rate limits)
JUPITER_API_KEY=

# ── RPC Endpoints (optional, defaults provided) ──────────────────
# SOLANA_RPC=https://api.mainnet-beta.solana.com
# BASE_RPC=https://mainnet.base.org
